smart-matrix-clock-esp32/build/

# ─── PlatformIO ───────────────────────────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
# generated by "pio init --ide"
.clang_complete
.gcc-flags.json
cmake-build-*/

# ─── Native host test suite (tests/) ──────────────────────────────────────────
# The entire build/ directory is generated by "cd tests && make"
tests/build/

# ─── C / C++ build artefacts ──────────────────────────────────────────────────
*.o
*.a
*.so
*.out
*.elf
*.bin
*.hex
*.map

# ─── Dependency / package managers ───────────────────────────────────────────
node_modules/

# ─── Logs & temp files ────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
